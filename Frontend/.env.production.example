# Variables de entorno requeridas para Frontend en Producción
NODE_ENV=production
PORT=4000
INTERNAL_BACKEND_URL=http://backend:3000/api/v1
NEXTAUTH_URL=https://elhospitaldelcomputador.com
NEXTAUTH_SECRET=CAMBIA_ESTA_CLAVE_SECRETA_NEXTAUTH_64_CHARS

# NOTA CRÍTICA: Las siguientes dos variables NEXT_PUBLIC_* se inyectan en tiempo
# de compilación (docker build args).
NEXT_PUBLIC_BACKEND_URL=https://elhospitaldelcomputador.com/api/v1
NEXT_PUBLIC_SITE_URL=https://elhospitaldelcomputador.com

