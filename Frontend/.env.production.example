# Variables de entorno requeridas para Frontend en Producción
NODE_ENV=production
PORT=4000
NEXTAUTH_URL=https://hospitaldelcomputador.com
NEXTAUTH_SECRET=CAMBIA_ESTA_CLAVE_SECRETA_NEXTAUTH_64_CHARS

# NOTA CRÍTICA: Las siguientes dos variables NEXT_PUBLIC_* se inyectan en tiempo
# de compilación (docker build).
NEXT_PUBLIC_BACKEND_URL=https://hospitaldelcomputador.com/api/v1
NEXT_PUBLIC_SITE_URL=https://hospitaldelcomputador.com

