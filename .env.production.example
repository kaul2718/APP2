# =========================================================================
# Plantilla de Variables de Entorno de Producción
# Proyecto: Hospital del Computador
# =========================================================================
# Copia este archivo como .env en el VPS Ubuntu antes de compilar y desplegar:
# cp .env.production.example .env

# --- 1. DOMINIO Y SSL / TLS (CADDY PROXY) ---
DOMAIN_NAME=elhospitaldelcomputador.com
ACME_EMAIL=admin@elhospitaldelcomputador.com

# --- 2. BASE DE DATOS POSTGRESQL (DOCKER INTERNO) ---
DB_USER=hdc_prod_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA_DB_POSTGRESQL_2026
DB_DATABASE=hdc_prod

# --- 3. SEGURIDAD Y JWT (BACKEND NESTJS) ---
# Generar secreto seguro de 64 caracteres: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTA_CLAVE_SECRETA_JWT_SUPER_SEGURA_64_CHARS
JWT_EXPIRATION=2h

# --- 4. AUTENTICACIÓN NEXTAUTH (FRONTEND NEXT.JS) ---
# Generar secreto seguro de 64 caracteres: openssl rand -base64 48
NEXTAUTH_SECRET=CAMBIA_ESTA_CLAVE_SECRETA_NEXTAUTH_64_CHARS
NEXTAUTH_URL=https://elhospitaldelcomputador.com

# --- 5. URLS PÚBLICAS Y CORS ---
# NOTA: Las variables NEXT_PUBLIC_* deben definirse antes del docker compose build
FRONTEND_URL=https://elhospitaldelcomputador.com
NEXT_PUBLIC_BACKEND_URL=https://elhospitaldelcomputador.com/api/v1
NEXT_PUBLIC_SITE_URL=https://elhospitaldelcomputador.com

# --- 6. ALMACENAMIENTO DE EVIDENCIAS Y DOCUMENTOS (CLOUDFLARE R2) ---
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=tu_cloudflare_account_id
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_BUCKET_NAME=hospital-computador-prod
R2_ENDPOINT=https://tu_cloudflare_account_id.r2.cloudflarestorage.com
R2_PRESIGNED_EXPIRATION=900

# --- 7. SERVICIO TRANSACCIONAL DE CORREO (BREVO) ---
BREVO_API_KEY=xkeysib-tu_clave_api_de_brevo
BREVO_SENDER_EMAIL=notificaciones@elhospitaldelcomputador.com

# --- 8. CREDENCIALES DEL ADMINISTRADOR INICIAL (SEEDER PRODUCTIVO) ---
# Estos valores se utilizarán para crear el primer usuario con rol 'admin'.
# Si el usuario ya existe en base de datos, el seeder no sobrescribirá su contraseña.
INITIAL_ADMIN_EMAIL=admin@elhospitaldelcomputador.com
INITIAL_ADMIN_PASSWORD=ContrasenaSuperSeguraAdmin2026!
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_LASTNAME=Principal
INITIAL_ADMIN_CEDULA=0601234567
INITIAL_ADMIN_PHONE=0991234567
INITIAL_ADMIN_ADDRESS=Av. Principal y Primera, Riobamba
INITIAL_ADMIN_CITY=Riobamba

