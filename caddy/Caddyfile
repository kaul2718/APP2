# =========================================================================
# Caddyfile - Reverse Proxy & Automatic SSL Configuration
# Hospital del Computador - Producción
# Dominio Oficial: elhospitaldelcomputador.com
# =========================================================================

{
    email {$ACME_EMAIL:admin@elhospitaldelcomputador.com}
    admin off
}

# 1. Redirección canónica permanente (301): www -> raíz
www.{$DOMAIN_NAME:elhospitaldelcomputador.com} {
    redir https://{$DOMAIN_NAME:elhospitaldelcomputador.com}{uri} permanent
}

# 2. Dominio principal con TLS automático (Let's Encrypt / ZeroSSL)
{$DOMAIN_NAME:elhospitaldelcomputador.com} {
    encode gzip zstd

    # Seguridad: Encabezados HTTP estándar de producción
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=300"
    }

    # Autenticación NextAuth (Next.js Frontend: /api/auth/*)
    handle /api/auth/* {
        reverse_proxy frontend:4000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # API REST NestJS (/api/v1/...)
    handle /api/* {
        reverse_proxy backend:3000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # WebSockets de Socket.IO (/socket.io/...)
    handle /socket.io/* {
        reverse_proxy backend:3000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Frontend Next.js (Rutas públicas, dashboard, auth, static assets)
    handle {
        reverse_proxy frontend:4000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
